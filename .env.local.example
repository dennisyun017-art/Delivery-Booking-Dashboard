# Supabase 프로젝트 설정 (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 서버 전용 — 절대 NEXT_PUBLIC_ 접두어를 붙이거나 클라이언트에 노출하지 마세요.
# Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=

# Resend (이메일 알림) — https://resend.com 에서 발급
RESEND_API_KEY=
# Resend에서 도메인을 인증하기 전까지는 onboarding@resend.dev 로 테스트 가능
RESEND_FROM_EMAIL=onboarding@resend.dev

# 관리자가 assembly 회사를 초대할 때 이메일 속 링크가 가리킬 주소.
# 로컬 개발: http://localhost:3000 (포트가 다르면 맞게 수정)
# 배포 후: https://내프로젝트.vercel.app (Vercel에도 동일하게 등록)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
